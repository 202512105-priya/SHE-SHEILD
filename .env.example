# SHE SHIELD Cloud & Application Environment Template
FLASK_ENV=development
PORT=5000
SECRET_KEY=sheshield_dev_secret_key_change_in_production

# Database Configuration
DATABASE_URL=postgresql://sheshield:secret@localhost:5432/sheshield_db
REDIS_URL=redis://localhost:6379/0

# Cloud Notification Gateways (Twilio / AWS SNS / FCM)
SMS_GATEWAY_API_KEY=mock_sms_gateway_key
SMS_SENDER_ID=SHESHIELD
FCM_SERVER_KEY=mock_fcm_server_key

# External Emergency Dispatch
EMERGENCY_DISPATCH_ENABLED=false
