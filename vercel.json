{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd she_shield && flutter build web --release && find build -mindepth 1 -maxdepth 1 ! -name web -exec rm -rf {} + && rm -rf .dart_tool",
  "outputDirectory": "she_shield/build/web",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "api/**",
      "excludeFiles": "{she_shield,docs,extracted_assets,backend,frontend,admin_dashboard,firebase,build}/**"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?__path=/health"
    },
    {
      "source": "/api/status",
      "destination": "/api?__path=/api/status"
    },
    {
      "source": "/api/:match*",
      "destination": "/api?__path=/api/:match*"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
