{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "git clone https://github.com/flutter/flutter.git --depth 1 -b stable _flutter && cd she_shield && ../_flutter/bin/flutter build web --release && cd .. && rm -rf _flutter she_shield/.dart_tool",
  "outputDirectory": "she_shield/build/web",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "api/**",
      "excludeFiles": "{_flutter,she_shield,docs,extracted_assets,backend,frontend,admin_dashboard,firebase,build}/**"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?__path=/health"
    },
    {
      "source": "/api/status",
      "destination": "/api?__path=/api/status"
    },
    {
      "source": "/api/:match*",
      "destination": "/api?__path=/api/:match*"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
