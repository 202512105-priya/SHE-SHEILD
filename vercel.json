{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?__path=/health"
    },
    {
      "source": "/api/status",
      "destination": "/api?__path=/api/status"
    },
    {
      "source": "/api/:match*",
      "destination": "/api?__path=/api/:match*"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
