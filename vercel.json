{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{she_shield/**,docs/**,extracted_assets/**,*.apk,*.pptx,*.docx,*.zip,*.sql,backend/**,frontend/**,admin_dashboard/**,firebase/**,she_shield 2/**,build/**}"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?__path=/health"
    },
    {
      "source": "/api/status",
      "destination": "/api?__path=/api/status"
    },
    {
      "source": "/api/:match*",
      "destination": "/api?__path=/api/:match*"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/index.html"
    }
  ]
}
