"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function getUserData() {\n      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;\n    }\n\n    function hasRole(role) {\n      return isAuthenticated() && getUserData().role == role;\n    }\n\n    function isUser(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function isLinkedGuardian(userId) {\n      return isAuthenticated() && (\n        exists(/databases/$(database)/documents/Guardians/$(userId + '_' + request.auth.uid))\n      );\n    }\n\n    function isVerifiedResponder() {\n      return hasRole('police') && getUserData().verified == true;\n    }\n\n    // Users Collection: Users read/write own, Admin read/write all, Linked Guardian read own\n    match /Users/{userId} {\n      allow read: if isUser(userId) || isLinkedGuardian(userId) || hasRole('admin');\n      allow write: if isUser(userId) || hasRole('admin');\n    }\n\n    // Guardians Collection: Linked User or Linked Guardian or Admin\n    match /Guardians/{relationshipId} {\n      allow read, write: if isAuthenticated() && (\n        resource.data.userId == request.auth.uid || \n        resource.data.guardianId == request.auth.uid || \n        hasRole('admin')\n      );\n      allow create: if isAuthenticated();\n    }\n\n    // Guardian Requests\n    match /GuardianRequests/{requestId} {\n      allow read, write: if isAuthenticated() && (\n        resource.data.userId == request.auth.uid || \n        resource.data.guardianId == request.auth.uid || \n        hasRole('admin')\n      );\n      allow create: if isAuthenticated();\n    }\n\n    // SOS Alerts & Emergency Sessions\n    match /SOSAlerts/{sosId} {\n      allow read: if isAuthenticated() && (\n        resource.data.userId == request.auth.uid ||\n        isLinkedGuardian(resource.data.userId) ||\n        isVerifiedResponder() ||
